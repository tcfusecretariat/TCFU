---
import BaseLayout from "@layouts/BaseLayout.astro";
import ResourceLibraryPage from "@components/ResourceLibraryPage.astro";
import { content } from "@data/content";

const locale = "fr";
const t = content[locale];
---

<BaseLayout locale={locale} title={`Centre de ressources | ${t.metaTitle}`} description="Lire les classiques, rencontrer une sagesse durable et explorer la culture traditionnelle." path="library">
  <ResourceLibraryPage locale={locale} />
</BaseLayout>
