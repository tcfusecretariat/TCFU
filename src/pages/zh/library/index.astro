---
import BaseLayout from "@layouts/BaseLayout.astro";
import ResourceLibraryPage from "@components/ResourceLibraryPage.astro";
import { content } from "@data/content";

const locale = "zh";
const t = content[locale];
---

<BaseLayout locale={locale} title={`文化資源中心 | ${t.metaTitle}`} description="閱讀經典，聆聽智慧，探索傳統文化。" path="library">
  <ResourceLibraryPage locale={locale} />
</BaseLayout>
