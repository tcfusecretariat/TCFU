---
import SanityLiveResources from "@components/SanityLiveResources.astro";
import { getResources } from "@lib/cms";
import { formatPdfSize } from "@lib/news";
import {
  editionsForTopic,
  libraryHref,
  resourceTopicChrome,
  type ResourceTopic
} from "@data/resource-topics";
import type { Locale } from "@data/site";

const { locale, topic } = Astro.props as { locale: Locale; topic: ResourceTopic };
const chrome = resourceTopicChrome[locale];
const extra = (await getResources(locale)).map((item) => ({
  slug: item.slug,
  title: item.title,
  language: item.language,
  description: item.description,
  file: item.file
}));
const editions = editionsForTopic(locale, topic, extra);
const published = topic.status === "published";
---

<main class="resource-page resource-topic">
  <nav class="resource-breadcrumb" aria-label="Breadcrumb">
    <a href={`/${locale}/`}>{chrome.home}</a>
    <span aria-hidden="true">/</span>
    <a href={libraryHref(locale)}>{chrome.hub}</a>
    <span aria-hidden="true">/</span>
    <span>{topic.title[locale]}</span>
  </nav>

  <header class="resource-topic-hero editorial-reveal">
    <img class="resource-topic-cover" src={topic.coverImage} alt={topic.coverImageAlt[locale]} />
    <div class="resource-topic-intro">
      <p class="section-kicker">{topic.resourceType[locale]}</p>
      <h1>{topic.title[locale]}</h1>
      <p class="resource-topic-subtitle">{topic.subtitle[locale]}</p>
      <p class="resource-topic-body">{topic.content[locale]}</p>
      <a class="text-link" href={libraryHref(locale)}>{chrome.back}</a>
    </div>
  </header>

  {published && editions.length > 0 && (
    <section class="resource-library editorial-reveal" aria-label={chrome.editions} data-resource-editions data-resource-library>
      {editions.map((edition) => (
        <article class="resource-reader" id={edition.slug}>
          <div class="resource-copy">
            <p class="section-kicker">{edition.language}</p>
            <h2>{edition.readerTitle}</h2>
            <p>{edition.description}</p>
            <p class="resource-edition-meta">
              <span>{chrome.format}: {edition.format}</span>
              {edition.bytes > 0 && <span>{chrome.size}: {formatPdfSize(edition.bytes)}</span>}
              {edition.external && <span>{chrome.external}</span>}
            </p>
            <div class="resource-actions">
              <a class="button primary" href={edition.file} target="_blank" rel="noopener noreferrer">{chrome.read}</a>
              <a class="button secondary" href={edition.file} download rel="noopener noreferrer">{chrome.download}</a>
            </div>
          </div>
          <div class="book-reader" data-reader data-pdf={edition.file}>
            <div class="book-toolbar">
              <button type="button" data-prev>{chrome.prev}</button>
              <span><strong data-page>1</strong> / <span data-total>…</span></span>
              <button type="button" data-next>{chrome.next}</button>
            </div>
            <div class="book-stage">
              <canvas data-canvas aria-label={`${edition.readerTitle} online reader`}></canvas>
              <p class="book-fallback" data-fallback hidden>
                <a class="button secondary" href={edition.file} target="_blank" rel="noopener noreferrer">{chrome.read}</a>
              </p>
            </div>
          </div>
        </article>
      ))}
    </section>
  )}

  {!published && (
    <p class="resource-topic-soon" role="status">{topic.summary[locale]}</p>
  )}
</main>

{published && (
  <script is:inline>
    (() => {
      const PDFJS_VERSION = "4.7.76";
      const base = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/build`;
      let libPromise = null;

      function loadPdfJs() {
        if (!libPromise) {
          libPromise = import(`${base}/pdf.min.mjs`).then((lib) => {
            lib.GlobalWorkerOptions.workerSrc = `${base}/pdf.worker.min.mjs`;
            return lib;
          });
        }
        return libPromise;
      }

      async function setupReader(reader, pdfjsLib) {
        const url = reader.dataset.pdf;
        const canvas = reader.querySelector("[data-canvas]");
        const ctx = canvas?.getContext("2d");
        const pageLabel = reader.querySelector("[data-page]");
        const totalLabel = reader.querySelector("[data-total]");
        const stage = reader.querySelector(".book-stage");
        const fallback = reader.querySelector("[data-fallback]");
        if (!url || !canvas || !ctx) return;

        let doc;
        let page = 1;
        let rendering = false;
        let queued = false;

        try {
          doc = await pdfjsLib.getDocument({ url, withCredentials: false }).promise;
        } catch (error) {
          console.warn("[reader] Failed to open PDF:", error);
          fallback?.removeAttribute("hidden");
          return;
        }

        if (totalLabel) totalLabel.textContent = String(doc.numPages);

        const render = async () => {
          if (rendering) {
            queued = true;
            return;
          }
          rendering = true;
          try {
            const pdfPage = await doc.getPage(page);
            const ratio = window.devicePixelRatio || 1;
            const stageWidth = (stage?.clientWidth || 800) - 4;
            const unscaled = pdfPage.getViewport({ scale: 1 });
            const scale = Math.min(2.2, stageWidth / unscaled.width);
            const viewport = pdfPage.getViewport({ scale: scale * ratio });
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            canvas.style.width = `${viewport.width / ratio}px`;
            canvas.style.height = `${viewport.height / ratio}px`;
            await pdfPage.render({ canvasContext: ctx, viewport }).promise;
            if (pageLabel) pageLabel.textContent = String(page);
          } catch (error) {
            console.warn("[reader] Failed to render page:", error);
          } finally {
            rendering = false;
            if (queued) {
              queued = false;
              render();
            }
          }
        };

        reader.querySelector("[data-prev]")?.addEventListener("click", () => {
          if (page > 1) {
            page -= 1;
            render();
          }
        });
        reader.querySelector("[data-next]")?.addEventListener("click", () => {
          if (page < doc.numPages) {
            page += 1;
            render();
          }
        });

        let resizeTimer;
        window.addEventListener("resize", () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(render, 200);
        });

        render();
      }

      window.initPdfReaders = async () => {
        const readers = Array.from(document.querySelectorAll("[data-reader]")).filter(
          (reader) => !reader.dataset.readerReady
        );
        if (!readers.length) return;
        let pdfjsLib;
        try {
          pdfjsLib = await loadPdfJs();
        } catch (error) {
          console.warn("[reader] Failed to load PDF.js:", error);
          document.querySelectorAll("[data-fallback]").forEach((el) => el.removeAttribute("hidden"));
          return;
        }
        readers.forEach((reader) => {
          reader.dataset.readerReady = "true";
          setupReader(reader, pdfjsLib);
        });
      };

      window.initPdfReaders();
    })();
  </script>
)}

{published && <SanityLiveResources locale={locale} read={chrome.read} download={chrome.download} />}
