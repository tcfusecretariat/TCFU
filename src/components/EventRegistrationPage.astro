---
import EventRegistrationForm from "@components/EventRegistrationForm.astro";
import { CONFERENCE_AGENDA_PDF, registrationCopy } from "@data/event-registration";
import { privacyPolicyContent, registrationPrivacyNotice } from "@data/privacy-policy-content";
import type { Locale } from "@data/site";
import { formatPdfSize } from "@lib/news";

const { locale } = Astro.props as { locale: Locale };
const t = registrationCopy[locale];
const noticeParagraphs = registrationPrivacyNotice[locale].split("\n\n");
const privacyPolicyLinkLabel = privacyPolicyContent[locale].privacyPolicyLinkLabel;
const agendaSize = formatPdfSize(CONFERENCE_AGENDA_PDF.size);
---

<main class={`registration-page registration-page--${locale} detail-page editorial-reveal`}>
  <article class="registration-shell detail-article">
    <header class="registration-header">
      <p class="section-kicker">{t.kicker}</p>
      <h1>
        {t.titleLines
          ? t.titleLines.map((line) => <span class="registration-title-line">{line}</span>)
          : t.title}
      </h1>
      <p class="registration-subtitle">{t.subtitle}</p>
      <div class="registration-meta">
        <p><strong>{t.date}</strong></p>
        <p>{t.venue}</p>
      </div>
      <a
        class="news-pdf-card registration-agenda-card"
        href={CONFERENCE_AGENDA_PDF.url}
        download={CONFERENCE_AGENDA_PDF.filename}
      >
        <span class="news-pdf-doc" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M7 3.5h7.2L19.5 9v11.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z" stroke="currentColor" stroke-width="1.4"></path>
            <path d="M14 3.5V9h5.5" stroke="currentColor" stroke-width="1.4"></path>
            <path d="M8.5 13h7M8.5 16.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="news-pdf-copy">
          <span class="news-pdf-kicker">{t.agendaDownload}</span>
          <span class="news-pdf-name">{t.agendaLabel}</span>
          {agendaSize && <span class="news-pdf-size">{agendaSize}</span>}
        </span>
        <span class="news-pdf-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 4v12.5M7.5 12.5 12 17l4.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M5 20h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </span>
      </a>
    </header>

    <aside class="registration-privacy-notice" aria-label="Privacy notice">
      {noticeParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>
        <a href={`/${locale}/privacy-policy/`}>{privacyPolicyLinkLabel}</a>
      </p>
    </aside>

    <EventRegistrationForm locale={locale} />
  </article>
</main>
