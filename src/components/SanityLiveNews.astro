---
import { getAllNewsApiUrl, getLatestNewsApiUrl, getNewsBySlugApiUrl, type NewsDetail, type NewsSummary } from "@lib/news";
import type { Locale } from "@data/site";

type Mode = "latest" | "list" | "article";

const {
  locale,
  mode,
  slug,
  limit = 3,
  kicker = "News",
  seedItems = [],
  seedArticle = null
} = Astro.props as {
  locale: Locale;
  mode: Mode;
  slug?: string;
  limit?: number;
  kicker?: string;
  seedItems?: NewsSummary[];
  seedArticle?: NewsDetail | null;
};

const apiUrl =
  mode === "latest"
    ? getLatestNewsApiUrl(locale, limit)
    : mode === "list"
      ? getAllNewsApiUrl(locale)
      : getNewsBySlugApiUrl(locale, slug || "");

const dateLocale = locale === "zh" ? "zh-Hant" : locale;
const chrome = {
  zh: { home: "首頁", news: "最新動態", tagline: "以故事傳遞更和平的世界", download: "下載", video: "影片", pdf: "附件 (PDF)" },
  en: { home: "Home", news: "News", tagline: "Sharing stories for a more peaceful world", download: "Download", video: "Video", pdf: "Attachment (PDF)" },
  fr: { home: "Accueil", news: "Actualités", tagline: "Partager des histoires pour un monde plus pacifique", download: "Télécharger", video: "Vidéo", pdf: "Pièce jointe (PDF)" }
}[locale];
---

<script
  is:inline
  define:vars={{
    apiUrl,
    mode,
    locale,
    kicker,
    dateLocale,
    chrome,
    seedItems,
    seedArticle,
    limit
  }}
>
  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function formatDate(value) {
    if (!value) return "";
    try {
      const date = new Date(value);
      if (locale === "zh") {
        return `${date.getUTCFullYear()}年${date.getUTCMonth() + 1}月${date.getUTCDate()}日`;
      }
      return date.toLocaleDateString(locale === "fr" ? "fr-FR" : "en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC"
      });
    } catch {
      return "";
    }
  }

  function formatPdfSize(bytes) {
    if (!bytes || bytes <= 0) return "";
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function renderPortableBody(blocks) {
    if (!Array.isArray(blocks) || blocks.length === 0) return "";
    return blocks
      .map((block) => {
        if (block?._type === "image") return "";
        const text = (block?.children || [])
          .map((child) => {
            const value = escapeHtml(child?.text || "");
            if (!value) return "";
            if ((child?.marks || []).includes("em")) return `<em>${value}</em>`;
            if ((child?.marks || []).includes("strong")) return `<strong>${value}</strong>`;
            return value;
          })
          .join("");
        if (!text) return "";
        if (block?.style === "h2") return `<h2>${text}</h2>`;
        if (block?.style === "h3") return `<h3>${text}</h3>`;
        if (block?.style === "blockquote") return `<blockquote>${text}</blockquote>`;
        return `<p>${text}</p>`;
      })
      .join("");
  }

  function mergeBySlug(primary, secondary) {
    const merged = new Map();
    for (const item of secondary || []) {
      if (item?.slug) merged.set(item.slug, item);
    }
    for (const item of primary || []) {
      if (!item?.slug) continue;
      merged.set(item.slug, { ...(merged.get(item.slug) || {}), ...item });
    }
    return [...merged.values()].sort(
      (a, b) => Date.parse(b.publishDate || "") - Date.parse(a.publishDate || "")
    );
  }

  function renderNewsCards(items) {
    return items
      .map((article) => {
        const category = escapeHtml(article.category || kicker);
        const title = escapeHtml(String(article.title || "").replace(/\s*\n\s*/g, " "));
        const href = `/${locale}/news/${encodeURIComponent(article.slug)}/`;
        const date = article.publishDate
          ? `<time datetime="${escapeHtml(article.publishDate)}">${escapeHtml(formatDate(article.publishDate))}</time>`
          : "";
        return `<article><p>${category}</p><h3><a href="${href}">${title}</a></h3>${date}</article>`;
      })
      .join("");
  }

  function renderArticle(article) {
    const crumb = escapeHtml(article.breadcrumbLabel || article.title || chrome.news);
    const banner = article.editorialBanner || {};
    const hasBanner = Boolean(banner.title || banner.kicker);
    const bannerHtml = hasBanner
      ? `<section class="news-editorial-banner"><div class="news-editorial-banner-copy">${
          banner.kicker ? `<p class="news-editorial-kicker">${escapeHtml(banner.kicker)}</p>` : ""
        }${banner.title ? `<p class="news-editorial-title">${escapeHtml(banner.title)}</p>` : ""}${
          banner.meta ? `<p class="news-editorial-meta">${escapeHtml(banner.meta)}</p>` : ""
        }${banner.tags ? `<p class="news-editorial-tags">${escapeHtml(banner.tags)}</p>` : ""}</div>${
          banner.aside ? `<p class="news-editorial-aside">${escapeHtml(banner.aside)}</p>` : ""
        }</section>`
      : "";
    const location = article.location
      ? `<p class="news-sidebar-item"><span class="news-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-5.4 7-11.2A7 7 0 0 0 5 9.8C5 15.6 12 21 12 21Z" stroke="currentColor" stroke-width="1.4"></path><circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.4"></circle></svg></span><span class="news-sidebar-text">${escapeHtml(article.location)}</span></p>`
      : "";
    const eventDate = article.eventDateLabel
      ? `<p class="news-sidebar-item"><span class="news-sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="15.5" rx="2" stroke="currentColor" stroke-width="1.4"></rect><path d="M8 3.5V7M16 3.5V7M3.5 10h17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg></span><span class="news-sidebar-text">${escapeHtml(article.eventDateLabel)}</span></p>`
      : "";
    const pdfSize = formatPdfSize(article.pdfSize);
    const pdf = article.pdfUrl
      ? `<a class="news-pdf-card" href="${escapeHtml(article.pdfUrl)}" download><span class="news-pdf-doc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 3.5h7.2L19.5 9v11.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z" stroke="currentColor" stroke-width="1.4"></path><path d="M14 3.5V9h5.5" stroke="currentColor" stroke-width="1.4"></path><path d="M8.5 13h7M8.5 16.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg></span><span class="news-pdf-copy"><span class="news-pdf-kicker">${escapeHtml(chrome.download)}</span><span class="news-pdf-name">${escapeHtml(article.pdfLabel || chrome.pdf)}</span>${pdfSize ? `<span class="news-pdf-size">${escapeHtml(pdfSize)}</span>` : ""}</span><span class="news-pdf-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 4v12.5M7.5 12.5 12 17l4.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5 20h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg></span></a>`
      : "";
    const video = article.videoUrl
      ? `<p class="news-article-extra"><a class="text-link" href="${escapeHtml(article.videoUrl)}">${escapeHtml(chrome.video)}</a></p>`
      : "";
    const date = article.publishDate
      ? `<time class="news-sidebar-date" datetime="${escapeHtml(article.publishDate)}">${escapeHtml(formatDate(article.publishDate))}</time>`
      : "";

    return `<main class="news-article-page editorial-reveal" data-sanity-news-article><div class="news-article-shell"><nav class="news-breadcrumb"><a href="/${locale}/">${escapeHtml(chrome.home)}</a><span aria-hidden="true">›</span><a href="/${locale}/news/">${escapeHtml(chrome.news)}</a><span aria-hidden="true">›</span><span>${crumb}</span></nav><header class="news-article-masthead"><p class="news-article-brand">${escapeHtml(chrome.news)}</p><p class="news-article-tagline">${escapeHtml(chrome.tagline)}</p></header>${bannerHtml}<div class="news-article-layout"><article class="news-article-main">${article.category ? `<p class="news-article-category">${escapeHtml(article.category)}</p>` : ""}<h1 class="news-article-title">${escapeHtml(article.title)}</h1>${article.subtitle ? `<p class="news-article-subtitle">${escapeHtml(article.subtitle)}</p>` : ""}${article.body ? `<div class="portable-body">${renderPortableBody(article.body)}</div>` : ""}${video}</article><aside class="news-article-sidebar">${date}${location}${eventDate}${pdf}</aside></div></div></main>`;
  }

  async function hydrateSanityNews() {
    try {
      const response = await fetch(apiUrl, { headers: { Accept: "application/json" } });
      if (!response.ok) return;
      const payload = await response.json();
      const result = payload.result;

      if (mode === "article") {
        const target = document.querySelector("[data-sanity-news-article]");
        if (!target) return;
        const article = result ? { ...(seedArticle || {}), ...result } : seedArticle;
        if (!article) return;
        target.outerHTML = renderArticle(article);
        document.title = `${article.seoTitle || article.title} | ${document.title.split(" | ").slice(1).join(" | ") || document.title}`;
        return;
      }

      const apiItems = Array.isArray(result) ? result : [];
      const items = mergeBySlug(apiItems, seedItems);
      if (items.length === 0) return;

      if (mode === "latest") {
        const list = document.querySelector("[data-sanity-news-list]");
        const section = document.querySelector("[data-sanity-news-section]");
        if (!list) return;
        list.innerHTML = renderNewsCards(items.slice(0, limit));
        section?.removeAttribute("hidden");
        return;
      }

      if (mode === "list") {
        const list = document.querySelector("[data-sanity-news-list]");
        const page = document.querySelector("[data-sanity-news-page]");
        if (list) {
          list.innerHTML = renderNewsCards(items);
          page?.removeAttribute("data-sanity-news-page");
          const placeholder = page?.querySelector(".placeholder-page");
          placeholder?.remove();
          if (!page?.querySelector(".section-heading")) {
            page?.insertAdjacentHTML(
              "afterbegin",
              `<div class="section-heading"><p class="section-kicker">${escapeHtml(kicker)}</p></div>`
            );
          }
          return;
        }
        if (!page) return;
        page.innerHTML = `<div class="section-heading"><p class="section-kicker">${escapeHtml(kicker)}</p></div><div class="news-list">${renderNewsCards(items)}</div>`;
        return;
      }
    } catch (error) {
      console.warn("[sanity] Live news refresh failed:", error);
    }
  }

  hydrateSanityNews();
</script>
