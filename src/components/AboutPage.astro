---
import LogoStorySection from "@components/LogoStorySection.astro";
import {
  aboutBrochureCopy,
  aboutParagraphsByLocale,
  getAboutBrochurePdf
} from "@data/about-page";
import type { Locale } from "@data/site";

const { locale, kicker } = Astro.props as { locale: Locale; kicker: string };
const paragraphs = aboutParagraphsByLocale[locale] ?? aboutParagraphsByLocale.en;
const brochure = getAboutBrochurePdf(locale);
const brochureCopy = aboutBrochureCopy[locale];
---

<main class="content-page detail-page about-page editorial-reveal">
  <article class="detail-article">
    <p class="section-kicker">{kicker}</p>
    <div class="portable-body about-intro">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <section class="about-brochure" aria-labelledby="about-brochure-heading">
      <div class="about-brochure-head">
        <h2 id="about-brochure-heading">{brochureCopy.title}</h2>
        <a class="text-link" href={brochure.url} download={brochure.filename}>
          {brochureCopy.download}
        </a>
      </div>
      <div class="book-reader about-brochure-reader" data-reader data-pdf={brochure.url}>
        <div class="book-toolbar">
          <button type="button" data-prev>{brochureCopy.prev}</button>
          <span aria-live="polite"><strong data-page>1</strong> / <span data-total>…</span></span>
          <button type="button" data-next>{brochureCopy.next}</button>
        </div>
        <div class="book-stage">
          <canvas data-canvas aria-label={brochureCopy.readerLabel}></canvas>
          <p class="book-fallback" data-fallback hidden>
            <a class="button secondary" href={brochure.url} target="_blank" rel="noopener">{brochureCopy.openFallback}</a>
          </p>
        </div>
      </div>
    </section>

    <LogoStorySection locale={locale} />
  </article>
</main>

<script is:inline>
  (() => {
    const PDFJS_VERSION = "4.7.76";
    const base = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/build`;
    const readers = Array.from(document.querySelectorAll(".about-brochure [data-reader]"));
    if (!readers.length) return;

    async function setupReader(reader, pdfjsLib) {
      const url = reader.dataset.pdf;
      const canvas = reader.querySelector("[data-canvas]");
      const ctx = canvas?.getContext("2d");
      const pageLabel = reader.querySelector("[data-page]");
      const totalLabel = reader.querySelector("[data-total]");
      const prevButton = reader.querySelector("[data-prev]");
      const nextButton = reader.querySelector("[data-next]");
      const stage = reader.querySelector(".book-stage");
      const fallback = reader.querySelector("[data-fallback]");
      if (!url || !canvas || !ctx) return;

      let doc;
      let page = 1;
      let rendering = false;
      let queued = false;

      try {
        doc = await pdfjsLib.getDocument({ url, withCredentials: false }).promise;
      } catch (error) {
        console.warn("[about-brochure] Failed to open PDF:", error);
        fallback?.removeAttribute("hidden");
        return;
      }

      if (totalLabel) totalLabel.textContent = String(doc.numPages);

      const syncControls = () => {
        if (prevButton instanceof HTMLButtonElement) prevButton.disabled = page <= 1;
        if (nextButton instanceof HTMLButtonElement) nextButton.disabled = page >= doc.numPages;
      };

      const render = async () => {
        if (rendering) {
          queued = true;
          return;
        }
        rendering = true;
        try {
          const pdfPage = await doc.getPage(page);
          const ratio = window.devicePixelRatio || 1;
          const stageWidth = (stage?.clientWidth || 800) - 4;
          const unscaled = pdfPage.getViewport({ scale: 1 });
          const scale = Math.min(2.2, stageWidth / unscaled.width);
          const viewport = pdfPage.getViewport({ scale: scale * ratio });
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          canvas.style.width = `${viewport.width / ratio}px`;
          canvas.style.height = `${viewport.height / ratio}px`;
          await pdfPage.render({ canvasContext: ctx, viewport }).promise;
          if (pageLabel) pageLabel.textContent = String(page);
          syncControls();
        } catch (error) {
          console.warn("[about-brochure] Failed to render page:", error);
        } finally {
          rendering = false;
          if (queued) {
            queued = false;
            render();
          }
        }
      };

      prevButton?.addEventListener("click", () => {
        if (page > 1) {
          page -= 1;
          render();
        }
      });
      nextButton?.addEventListener("click", () => {
        if (page < doc.numPages) {
          page += 1;
          render();
        }
      });

      reader.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft" && page > 1) {
          event.preventDefault();
          page -= 1;
          render();
        }
        if (event.key === "ArrowRight" && page < doc.numPages) {
          event.preventDefault();
          page += 1;
          render();
        }
      });

      let resizeTimer;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(render, 200);
      });

      syncControls();
      render();
    }

    (async () => {
      let pdfjsLib;
      try {
        pdfjsLib = await import(`${base}/pdf.min.mjs`);
        pdfjsLib.GlobalWorkerOptions.workerSrc = `${base}/pdf.worker.min.mjs`;
      } catch (error) {
        console.warn("[about-brochure] Failed to load PDF.js:", error);
        document.querySelectorAll(".about-brochure [data-fallback]").forEach((el) => el.removeAttribute("hidden"));
        return;
      }
      readers.forEach((reader) => {
        if (reader instanceof HTMLElement) reader.tabIndex = 0;
        setupReader(reader, pdfjsLib);
      });
    })();
  })();
</script>
