---
import type { Locale } from "@data/site";
import {
  libraryHubCopy,
  topicDisplaySubtitle,
  topicHref,
  topicSearchBlob,
  visibleResourceTopics,
  type ResourceTopic
} from "@data/resource-topics";
import { fallbackResources } from "@data/resources";

const { locale } = Astro.props as { locale: Locale };
const copy = libraryHubCopy[locale];
const topics = visibleResourceTopics();
const hasVideo = topics.some((topic) => topic.resourceTypeKey === "video" && topic.status === "published");
const languageOptions = Array.from(
  new Set(fallbackResources[locale].flatMap((item) => (item.language ? [item.language] : [])))
);
const themeOptions = Array.from(new Set(topics.flatMap((topic) => topic.themes[locale])));
const cards = topics.map((topic) => serializeCard(locale, topic));

function serializeCard(locale: Locale, topic: ResourceTopic) {
  return {
    slug: topic.slug,
    status: topic.status,
    href: topic.status === "published" ? topicHref(locale, topic.slug) : "",
    typeKey: topic.resourceTypeKey,
    type: topic.resourceType[locale],
    title: topic.title[locale],
    subtitle: topicDisplaySubtitle(locale, topic),
    summary: topic.summary[locale],
    coverImage: topic.coverImage,
    coverImageAlt: topic.coverImageAlt[locale],
    languages: topic.slug === "qunshu-zhiyao" ? fallbackResources[locale].map((item) => item.language) : [],
    themes: topic.themes[locale],
    publishDate: topic.publishDate,
    search: topicSearchBlob(locale, topic)
  };
}
---

<main class="resource-page resource-hub">
  <section class="resource-hub-hero editorial-reveal">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.title}</h1>
    <p class="resource-hub-lede">{copy.subtitle}</p>
    <form class="resource-hub-search" role="search" data-resource-search>
      <label class="sr-only" for="resource-hub-query">{copy.searchPlaceholder}</label>
      <input id="resource-hub-query" name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" data-resource-query />
      <button class="button primary" type="submit">{copy.searchSubmit}</button>
    </form>
  </section>

  <section class="resource-hub-toolbar" aria-label={copy.filterAll}>
    <div class="resource-hub-types" role="tablist" data-resource-types>
      <button type="button" class="is-active" data-type="all">{copy.filterAll}</button>
      <button type="button" data-type="ebook">{copy.filterEbook}</button>
      {hasVideo && <button type="button" data-type="video">{copy.filterVideo}</button>}
    </div>
    <div class="resource-hub-filters">
      {languageOptions.length > 0 && (
        <label>
          <span class="sr-only">{copy.language}</span>
          <select data-resource-language>
            <option value="">{copy.language}</option>
            {languageOptions.map((language) => (
              <option value={language}>{language}</option>
            ))}
          </select>
        </label>
      )}
      {themeOptions.length > 0 && (
        <label>
          <span class="sr-only">{copy.theme}</span>
          <select data-resource-theme>
            <option value="">{copy.theme}</option>
            {themeOptions.map((theme) => (
              <option value={theme}>{theme}</option>
            ))}
          </select>
        </label>
      )}
      <label>
        <span class="sr-only">{copy.sort}</span>
        <select data-resource-sort>
          <option value="newest">{copy.sortNewest}</option>
        </select>
      </label>
    </div>
  </section>

  <section class="resource-hub-grid" data-resource-grid>
    {cards.map((card) => {
      const published = card.status === "published";
      const inner = (
        <>
          <div class="resource-hub-media">
            <img src={card.coverImage} alt={card.coverImageAlt} />
          </div>
          <div class="resource-hub-copy">
            <h2>{card.title}</h2>
            {card.subtitle && <p class="resource-hub-subtitle">{card.subtitle}</p>}
            <p class="resource-hub-type">{card.type}</p>
            {card.summary && <p class="resource-hub-summary">{card.summary}</p>}
            {published ? (
              <span class="button primary resource-hub-cta">{copy.readOnline}</span>
            ) : (
              <span class="resource-hub-soon">{copy.comingSoon}</span>
            )}
          </div>
        </>
      );

      return published ? (
        <a
          class="resource-hub-card"
          href={card.href}
          data-resource-card
          data-status={card.status}
          data-type={card.typeKey}
          data-languages={card.languages.join("|")}
          data-themes={card.themes.join("|")}
          data-search={card.search}
          data-date={card.publishDate}
        >
          {inner}
        </a>
      ) : (
        <article
          class="resource-hub-card is-soon"
          data-resource-card
          data-status={card.status}
          data-type={card.typeKey}
          data-languages={card.languages.join("|")}
          data-themes={card.themes.join("|")}
          data-search={card.search}
          data-date={card.publishDate}
        >
          {inner}
        </article>
      );
    })}
  </section>
</main>

<script is:inline>
  (() => {
    const knownHashes = ["qunshu-zhiyao-360-zh", "qunshu-zhiyao-es", "qunshu-zhiyao-ja-vol3", "qunshu-zhiyao-fr-vol1"];
    const hash = location.hash.replace("#", "");
    if (hash && knownHashes.includes(hash)) {
      const parts = location.pathname.split("/").filter(Boolean);
      const locale = parts[0] || "en";
      location.replace(`/${locale}/library/qunshu-zhiyao/#${hash}`);
      return;
    }

    const form = document.querySelector("[data-resource-search]");
    const queryInput = document.querySelector("[data-resource-query]");
    const typeButtons = Array.from(document.querySelectorAll("[data-resource-types] button"));
    const languageSelect = document.querySelector("[data-resource-language]");
    const themeSelect = document.querySelector("[data-resource-theme]");
    const cards = Array.from(document.querySelectorAll("[data-resource-card]"));
    let activeType = "all";

    function applyFilters() {
      const query = (queryInput instanceof HTMLInputElement ? queryInput.value : "").trim().toLowerCase();
      const language = languageSelect instanceof HTMLSelectElement ? languageSelect.value : "";
      const theme = themeSelect instanceof HTMLSelectElement ? themeSelect.value : "";

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const search = (card.dataset.search || "").toLowerCase();
        const type = card.dataset.type || "";
        const languages = (card.dataset.languages || "").split("|").filter(Boolean);
        const themes = (card.dataset.themes || "").split("|").filter(Boolean);
        const typeOk = activeType === "all" || type === activeType;
        const queryOk = !query || search.includes(query);
        const languageOk = !language || languages.includes(language);
        const themeOk = !theme || themes.includes(theme);
        card.hidden = !(typeOk && queryOk && languageOk && themeOk);
      });
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      applyFilters();
    });
    queryInput?.addEventListener("input", applyFilters);
    languageSelect?.addEventListener("change", applyFilters);
    themeSelect?.addEventListener("change", applyFilters);
    typeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.getAttribute("data-type") || "all";
        typeButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        applyFilters();
      });
    });
  })();
</script>
