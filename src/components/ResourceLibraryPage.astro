---
import type { Locale } from "@data/site";
import {
  libraryHubCopy,
  topicDisplaySubtitle,
  topicHref,
  topicSearchBlob,
  visibleResourceTopics,
  type ResourceTopic
} from "@data/resource-topics";

const { locale } = Astro.props as { locale: Locale };
const copy = libraryHubCopy[locale];
const topics = visibleResourceTopics();
const cards = topics.map((topic) => serializeCard(locale, topic));

function serializeCard(locale: Locale, topic: ResourceTopic) {
  return {
    slug: topic.slug,
    status: topic.status,
    href: topic.status === "published" ? topicHref(locale, topic.slug) : "",
    type: topic.resourceType[locale],
    title: topic.title[locale],
    subtitle: topicDisplaySubtitle(locale, topic),
    summary: topic.summary[locale],
    coverImage: topic.coverImage,
    coverImageAlt: topic.coverImageAlt[locale],
    search: topicSearchBlob(locale, topic)
  };
}
---

<main class="resource-page resource-hub">
  <section class="resource-hub-hero editorial-reveal">
    <h1 class="section-kicker">{copy.kicker}</h1>
    <p class="resource-hub-lede">{copy.subtitle}</p>
    <form class="resource-hub-search" role="search" data-resource-search>
      <label class="sr-only" for="resource-hub-query">{copy.searchPlaceholder}</label>
      <input id="resource-hub-query" name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" data-resource-query />
      <button class="button primary" type="submit">{copy.searchSubmit}</button>
    </form>
  </section>

  <section class="resource-hub-grid" data-resource-grid>
    {cards.map((card) => {
      const published = card.status === "published";
      const inner = (
        <>
          <div class="resource-hub-media">
            <img src={card.coverImage} alt={card.coverImageAlt} />
          </div>
          <div class="resource-hub-copy">
            <h2>{card.title}</h2>
            {card.subtitle && <p class="resource-hub-subtitle">{card.subtitle}</p>}
            <p class="resource-hub-type">{card.type}</p>
            {card.summary && <p class="resource-hub-summary">{card.summary}</p>}
            {published ? (
              <span class="button primary resource-hub-cta">{copy.readOnline}</span>
            ) : (
              <span class="resource-hub-soon">{copy.comingSoon}</span>
            )}
          </div>
        </>
      );

      return published ? (
        <a
          class="resource-hub-card"
          href={card.href}
          data-resource-card
          data-search={card.search}
        >
          {inner}
        </a>
      ) : (
        <article
          class="resource-hub-card is-soon"
          data-resource-card
          data-search={card.search}
        >
          {inner}
        </article>
      );
    })}
  </section>
</main>

<script is:inline>
  (() => {
    const knownHashes = ["qunshu-zhiyao-360-zh", "qunshu-zhiyao-es", "qunshu-zhiyao-ja-vol3", "qunshu-zhiyao-fr-vol1"];
    const hash = location.hash.replace("#", "");
    if (hash && knownHashes.includes(hash)) {
      const parts = location.pathname.split("/").filter(Boolean);
      const locale = parts[0] || "en";
      location.replace(`/${locale}/library/qunshu-zhiyao/#${hash}`);
      return;
    }

    const form = document.querySelector("[data-resource-search]");
    const queryInput = document.querySelector("[data-resource-query]");
    const cards = Array.from(document.querySelectorAll("[data-resource-card]"));

    function applyFilters() {
      const query = (queryInput instanceof HTMLInputElement ? queryInput.value : "").trim().toLowerCase();

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const search = (card.dataset.search || "").toLowerCase();
        card.hidden = Boolean(query) && !search.includes(query);
      });
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      applyFilters();
    });
    queryInput?.addEventListener("input", applyFilters);
  })();
</script>
